{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated Care Connect user profile (elder or caretaker).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID." },
        "displayName": { "type": "string", "description": "User display name." },
        "role": { "type": "string", "enum": ["elder", "caretaker"] },
        "email": { "type": "string", "description": "User email address." },
        "avatarKey": { "type": "string", "enum": ["grandpa", "grandma", "caretaker"] },
        "themePreset": { "type": "string", "enum": ["classic_pastel", "warm_cream", "high_contrast"] },
        "darkMode": { "type": "boolean" },
        "textScale": { "type": "string", "enum": ["normal", "large", "extra_large"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": ["userId", "displayName", "role", "createdAt", "updatedAt"]
    },
    "ElderProfile": {
      "title": "ElderProfile",
      "description": "Care profile for an elder with daily water goal, location state, and authorized UIDs.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "displayName": { "type": "string" },
        "dailyWaterGoal": { "type": "integer" },
        "locationSharingEnabled": { "type": "boolean" },
        "onlineStatus": { "type": "string", "enum": ["online", "offline"] },
        "avatarKey": { "type": "string", "enum": ["grandpa", "grandma"] },
        "lastKnownArea": { "type": "string" },
        "lastLocationAt": { "type": "string", "format": "date-time" },
        "ageLabel": { "type": "string" },
        "notes": { "type": "string" },
        "fallDetectionEnabled": { "type": "boolean" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "displayName", "dailyWaterGoal", "locationSharingEnabled", "onlineStatus", "avatarKey", "authorizedUids", "createdAt", "updatedAt"]
    },
    "PairingInvite": {
      "title": "PairingInvite",
      "description": "Single-use daily-rotating 6-character pairing code generated by an elder.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "elderId": { "type": "string" },
        "elderName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "claimed", "revoked"] },
        "dayKey": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "claimedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "elderId", "elderName", "status", "dayKey", "expiresAt", "createdAt", "updatedAt"]
    },
    "CaretakerLink": {
      "title": "CaretakerLink",
      "description": "Authorized link between an elder and a caretaker.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "elderName": { "type": "string" },
        "caretakerId": { "type": "string" },
        "caretakerName": { "type": "string" },
        "inviteCode": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "elderName", "caretakerId", "caretakerName", "inviteCode", "status", "authorizedUids", "createdAt", "updatedAt"]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "Prescription-entered medicine reminder schedule.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "name": { "type": "string" },
        "dosage": { "type": "string" },
        "timeMinutes": { "type": "integer" },
        "timeLabel": { "type": "string" },
        "repeatSchedule": { "type": "string" },
        "activeStatus": { "type": "string", "enum": ["active", "paused"] },
        "prescriptionNote": { "type": "string" },
        "createdByUid": { "type": "string" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "name", "dosage", "timeMinutes", "timeLabel", "repeatSchedule", "activeStatus", "createdByUid", "authorizedUids", "createdAt", "updatedAt"]
    },
    "MedicineLog": {
      "title": "MedicineLog",
      "description": "Daily status record for a scheduled medicine reminder.",
      "type": "object",
      "properties": {
        "medicineId": { "type": "string" },
        "elderId": { "type": "string" },
        "medicineName": { "type": "string" },
        "dosage": { "type": "string" },
        "dateKey": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "taken", "skipped"] },
        "loggedByUid": { "type": "string" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["medicineId", "elderId", "medicineName", "dosage", "dateKey", "status", "loggedByUid", "authorizedUids", "createdAt", "updatedAt"]
    },
    "WaterLog": {
      "title": "WaterLog",
      "description": "Daily hydration glass count for an elder.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "dateKey": { "type": "string" },
        "glasses": { "type": "integer" },
        "goal": { "type": "integer" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "dateKey", "glasses", "goal", "authorizedUids", "createdAt", "updatedAt"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Assigned daily task for an elder.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "title": { "type": "string" },
        "dueDateText": { "type": "string" },
        "dueTimeText": { "type": "string" },
        "completionStatus": { "type": "string", "enum": ["pending", "completed"] },
        "assignedByUid": { "type": "string" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "title", "dueDateText", "dueTimeText", "completionStatus", "assignedByUid", "authorizedUids", "createdAt", "updatedAt"]
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "description": "Emergency contact entry for an elder (supports 5+ contacts).",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "relationship": { "type": "string" },
        "priorityOrder": { "type": "integer" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "name", "phoneNumber", "relationship", "priorityOrder", "authorizedUids", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Upcoming care or clinic appointment.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "dateTimeText": { "type": "string" },
        "reminderFlag": { "type": "string", "enum": ["enabled", "disabled"] },
        "notes": { "type": "string" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "title", "location", "dateTimeText", "reminderFlag", "authorizedUids", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Care activity notification for medicine, tasks, appointments, or SOS.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "category": { "type": "string", "enum": ["medicine", "task", "appointment", "sos", "call", "system"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "readStatus": { "type": "string", "enum": ["unread", "read"] },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "category", "title", "body", "readStatus", "authorizedUids", "createdAt", "updatedAt"]
    },
    "SosEvent": {
      "title": "SosEvent",
      "description": "Emergency SOS event triggered by an elder or fall detection sensor and visible to linked caretakers.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "elderName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "acknowledged", "cancelled"] },
        "areaLabel": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "deliveryState": { "type": "string", "enum": ["delivered", "acknowledged", "cancelled"] },
        "acknowledgedByUid": { "type": "string" },
        "source": { "type": "string", "enum": ["manual", "fall_detection", "fall_simulation"] },
        "peakGForce": { "type": "number" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "elderName", "status", "areaLabel", "deliveryState", "authorizedUids", "createdAt", "updatedAt"]
    },
    "VideoCallSession": {
      "title": "VideoCallSession",
      "description": "Authorized video call signaling and session state between an elder and linked caretakers.",
      "type": "object",
      "properties": {
        "elderId": { "type": "string" },
        "elderName": { "type": "string" },
        "callerUid": { "type": "string" },
        "callerName": { "type": "string" },
        "callerRole": { "type": "string", "enum": ["elder", "caretaker"] },
        "roomCode": { "type": "string" },
        "callStatus": { "type": "string", "enum": ["ringing", "active", "ended", "declined"] },
        "callerCameraEnabled": { "type": "boolean" },
        "calleeCameraEnabled": { "type": "boolean" },
        "callerMicMuted": { "type": "boolean" },
        "calleeMicMuted": { "type": "boolean" },
        "authorizedUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elderId", "elderName", "callerUid", "callerName", "callerRole", "roomCode", "callStatus", "callerCameraEnabled", "calleeCameraEnabled", "callerMicMuted", "calleeMicMuted", "authorizedUids", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account and appearance preferences."
    },
    "/elder_profiles/{elderId}": {
      "schema": { "$ref": "#/entities/ElderProfile" },
      "description": "Elder profiles shared with authorized caretakers."
    },
    "/pairing_invites/{code}": {
      "schema": { "$ref": "#/entities/PairingInvite" },
      "description": "Consent-based pairing codes for linking caretakers to elders."
    },
    "/caretaker_links/{linkId}": {
      "schema": { "$ref": "#/entities/CaretakerLink" },
      "description": "Active and revoked caretaker-elder authorization links."
    },
    "/medicines/{medicineId}": {
      "schema": { "$ref": "#/entities/Medicine" },
      "description": "Configured medicine reminder schedules."
    },
    "/medicine_logs/{logId}": {
      "schema": { "$ref": "#/entities/MedicineLog" },
      "description": "Daily medicine reminder taken/pending/skipped logs."
    },
    "/water_logs/{logId}": {
      "schema": { "$ref": "#/entities/WaterLog" },
      "description": "Daily water intake progress logs."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "Assigned care tasks."
    },
    "/emergency_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/EmergencyContact" },
      "description": "Emergency contacts per elder."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Upcoming appointments."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Cross-device activity notifications."
    },
    "/sos_events/{eventId}": {
      "schema": { "$ref": "#/entities/SosEvent" },
      "description": "SOS emergency events and acknowledgment states."
    },
    "/video_calls/{callId}": {
      "schema": { "$ref": "#/entities/VideoCallSession" },
      "description": "Authorized video calls between elders and linked caretakers."
    }
  }
}
